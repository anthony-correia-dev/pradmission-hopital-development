# Copier ce fichier vers .env.local et remplir les valeurs
# NE JAMAIS COMMITER les fichiers .env avec des vraies valeurs !

# 🎯 OCR Cloud Flow Trigger IDs
# Trigger pour l'OCR des cartes d'identité (passeports, CNI, etc.)
VITE_OCR_IDENTITY_TRIGGER_ID=your-identity-trigger-id-here

# Trigger pour l'OCR des cartes d'assurance suisses (format SASIS)
VITE_OCR_INSURANCE_TRIGGER_ID=your-insurance-trigger-id-here

# Environment identifier (development | dev | test | production)
VITE_ENVIRONMENT=development
