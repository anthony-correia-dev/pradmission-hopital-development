# Environnement PROD Power Platform

# 🔐 MODE MOCK - DÉSACTIVÉ EN PRODUCTION
VITE_MOCK_ENABLED=false
# VITE_MOCK_OTP_CODE - NON DÉFINI EN PROD
# VITE_MOCK_BIRTH_DATE - NON DÉFINI EN PROD

# 🎯 OCR Cloud Flow Trigger IDs
# Trigger pour l'OCR des cartes d'identité (passeports, CNI, etc.)
VITE_OCR_IDENTITY_TRIGGER_ID=PROD_IDENTITY_TRIGGER_ID_A_CONFIGURER

# Trigger pour l'OCR des cartes d'assurance suisses (format SASIS)
VITE_OCR_INSURANCE_TRIGGER_ID=PROD_INSURANCE_TRIGGER_ID_A_CONFIGURER

VITE_ENVIRONMENT=production
